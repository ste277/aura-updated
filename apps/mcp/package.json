{
  "name": "aura-mcp",
  "private": true,
  "version": "0.0.1",
  "description": "Local-only, read-only, non-personalized MCP server for Aura (stdio transport). Not deployed.",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "start": "node dist/apps/mcp/src/index.js",
    "test": "npm run build && node --test dist/apps/mcp/test/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "astronomy-engine": "2.1.19",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "20.14.0",
    "typescript": "5.5.4"
  }
}
