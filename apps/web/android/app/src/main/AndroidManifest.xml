<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- AURA-ANDROID-REL-04 (S5A-F2 / BK-1): no Android backup or device transfer.
         The shell keeps no user data of its own: everything lives on the server,
         and the only local state is the WebView profile (the as_session cookie,
         localStorage, cache). Restoring that profile from a cloud backup or a
         device-to-device transfer could bring back a session that was signed out
         after the backup was taken. allowBackup="false" stops cloud backup and
         adb backup on every API level and device transfer up to API 30; from
         API 31 device transfer ignores allowBackup, so data_extraction_rules.xml
         excludes every domain for both cloud backup and device transfer. -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- AURA-ANDROID-REL-03 (from AURA-MOBILE-01-M1 / COMPAT-03): approximate
         location for "Use my current location" (city-level Panchangam timings).
         Coarse only: ACCESS_FINE_LOCATION and background location are deliberately
         not requested. The patched @capacitor/geolocation 6.1.1 uses the coarse
         alias on every API level when only this permission is declared. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
</manifest>
