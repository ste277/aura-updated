# Copy this to .env.local for local dev, or set these in Railway's project settings.

# Required
DATABASE_URL="postgresql://user:password@localhost:5432/auraschedule_dev"
AUTH_SECRET="generate-with: openssl rand -hex 32"

# Sign-in email delivery. Configure ONE provider. With neither set, development
# returns the link/code inline in the API response; production refuses to serve
# sign-in at all (fails closed — it will never leak credentials).
#
# Preferred: mail-o-mail (shared with Parley; sends from a verified @voyforge.com address)
MOM_API_KEY=""
MOM_FROM_EMAIL="aura@voyforge.com"
# MOM_API_URL="https://mail-o-mail.com/api/v1/send"   # override only if the endpoint changes
#
# Alternative: Resend
RESEND_API_KEY=""
RESEND_FROM_ADDRESS="AuraSchedule <onboarding@resend.dev>"

# Optional — enables real LLM answers in Ask Aura (Google Gemini). Without it,
# Ask Aura still answers most questions deterministically from the panchang
# engine and falls back to canned guidance for the rest.
GEMINI_API_KEY=""
