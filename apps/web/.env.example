# Copy this to .env.local for local dev, or set these in Railway's project settings.

# Required
DATABASE_URL="postgresql://user:password@localhost:5432/auraschedule_dev"
AUTH_SECRET="generate-with: openssl rand -hex 32"

# Sign-in email delivery. Configure ONE provider. With neither set, development
# returns the link/code inline in the API response; production refuses to serve
# sign-in at all (fails closed — it will never leak credentials).
#
# Preferred: mail-o-mail (shared with Parley; sends from a verified @voyforge.com address)
MOM_API_KEY=""
MOM_FROM_EMAIL="aura@voyforge.com"
# MOM_API_URL="https://mail-o-mail.com/api/v1/send"   # override only if the endpoint changes
#
# Alternative: Resend
RESEND_API_KEY=""
RESEND_FROM_ADDRESS="AuraSchedule <onboarding@resend.dev>"

# Optional — enables real LLM answers in Ask Aura (Google Gemini). Without it,
# Ask Aura still answers most questions deterministically from the panchang
# engine and falls back to canned guidance for the rest.
GEMINI_API_KEY=""

# Optional — enables "Use my current location" (GPS) and "Search for a
# place" on the Location & Time screen (OpenCage Geocoding API, server-side
# only — never sent to the client, never required in a browser bundle).
# Get a free key at https://opencagedata.com/api (no card required for the
# free tier) and set it here or in Railway's project settings for any
# deployed environment that should offer search/GPS.
#
# Without it, GET /api/location/search and GET /api/location/reverse both
# return a 503 with a clear "...is not available right now." message — they
# fail closed, never silently. This does NOT block location confirmation:
# the curated city list and manual coordinate entry under "Advanced
# options" on the Location & Time screen, and the "Confirm <city>" action
# for a user's already-current location, both call PATCH /api/users/location
# directly and need no geocoding provider at all.
OPENCAGE_API_KEY=""

# Optional — gates GET /api/internal/product-metrics (developer-only funnel
# metrics). Without it, the route always 404s (fails closed, like
# AUTH_SECRET). Send it back as the x-internal-metrics-secret header.
INTERNAL_METRICS_SECRET=""
