datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  cityName        String
  latitude        Float
  longitude       Float
  timezone        String   @default("Asia/Kolkata") // IANA name, e.g. 'Asia/Kolkata', 'America/New_York'
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  // Birth profile — nullable, since not every user will fill this in (Phase 2
  // birth-chart feature is optional on top of the core daily dial).
  birthDate       DateTime? @db.Timestamptz(3)
  birthTime       String?   // "HH:MM", 24h, local to birthTimezone
  birthCityName   String?
  birthLatitude   Float?
  birthLongitude  Float?
  birthTimezone   String?   // IANA name

  // Aura Reminders V1 -- user-level preference (brief section 14): default
  // ON, default lead time 15 minutes before start. No per-activity config
  // in V1 ("do NOT add per-activity config unless trivial").
  remindersEnabled    Boolean @default(true)
  reminderLeadMinutes Int     @default(15)

  // Intentional Day Builder V1 -- master on/off + muted DailyIntentionGroupId
  // values (dailyIntentions.ts), same minimal-preference restraint as
  // remindersEnabled/reminderLeadMinutes above. No per-activity config.
  dayBuilderEnabled      Boolean  @default(true)
  dayBuilderMutedGroups  String[] @default([])

  // Personalization Foundation V1 -- lightweight, explicit, user-controlled
  // priorities affecting Day Builder candidate ORDERING only (never
  // timing/scoring). dayBuilderPriorities stores UserPriorityGroup values
  // (dayBuilder.ts) -- a presentation mapping onto the EXISTING
  // DailyIntentionGroupId taxonomy, not a new one. dayBuilderPriorityPersonIds
  // stores existing SavedPerson ids ("make more time for"). An empty
  // dayBuilderPriorities array is a fully valid, permanent state.
  dayBuilderPriorities                String[] @default([])
  dayBuilderPriorityPersonIds         String[] @default([])
  dayBuilderPrioritiesPromptDismissed Boolean  @default(false)

  habitLogs       HabitLog[]
  visitLogs       VisitLog[]
  habits          Habit[]
  customCities    CustomCity[]
  dailyReflections DailyReflection[]
  plannedActivities PlannedActivity[]
  savedPeople     SavedPerson[]
  auraMoments     AuraMoment[]
  productEvents   ProductEvent[]
  reminderAttentions ReminderAttention[]
  reminderDeliveries ReminderDelivery[]
  pushSubscriptions  PushSubscription[]
}

// A lightweight profile for someone the user plans with -- the minimum
// natal information Personal Muhurtham-style personalization needs, not a
// second full user account. Deliberately named SavedPerson (not
// PartnerProfile): relationshipType covers PARTNER today but is expected to
// grow (SPOUSE, FAMILY, FRIEND, OTHER) without a schema change. Every row is
// owned by exactly one User (ownerUserId) and is never readable, listable,
// or mutable by anyone else -- see apps/web/lib/db.ts's SavedPerson CRUD,
// which always scopes by ownerUserId, never by id alone.
//
// birthLatitude/birthLongitude are OPTIONAL: buildNatalContext() (packages/
// vedic/src/natalChart.ts) uses geocentric sidereal longitude, which does
// not depend on observer location -- only birthDate + birthTime +
// birthTimezone are actually required to derive Janma Nakshatra/Rashi. They
// still naturally travel together with birthTimezone when a birth city is
// picked (the existing city-picker UX), so they're stored when available
// but never required.
//
// No calculated planetary positions are stored here -- natal context is
// always derived on read via getSavedPersonNatalContext(), the same
// buildNatalContext() every other personalization consumer uses.
model SavedPerson {
  id              String   @id @default(uuid())
  ownerUserId     String
  owner           User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  name            String
  relationshipType String  @default("OTHER") // "PARTNER" | "SPOUSE" | "FAMILY" | "FRIEND" | "OTHER"

  birthDate       DateTime @db.Timestamptz(3)
  birthTime       String   // "HH:MM", 24h, local to birthTimezone -- required, see module note above
  birthTimezone   String   // IANA name -- required
  birthCityName   String?
  birthLatitude   Float?
  birthLongitude  Float?

  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  auraMoments     AuraMoment[]

  @@index([ownerUserId])
}

// A snapshot of a selected Muhurtham recommendation, shared via an opaque
// public token -- "what Aura recommended when this was shared", never
// re-derived on read (no Panchang/Muhurta/natal recomputation). The public
// page and the public response endpoint resolve ONLY by publicToken --
// bearer-access, like a normal share link -- never by this row's own `id`.
// Deliberately stores no natal/birth data at all (see apps/web/lib/auraMoments.ts's
// PublicAuraMoment DTO, which allow-lists fields rather than ever spreading
// this row), so there is nothing here for a public reader to leak beyond
// what the owner explicitly chose to share.
model AuraMoment {
  id                      String    @id @default(uuid())
  ownerUserId             String
  owner                   User      @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  publicToken             String    @unique

  scope                   String    // "GENERAL" | "PERSONAL" | "SHARED"
  // Product Structure V2: where the selected timing came from -- "PLAN"
  // (Find/Check/Compare, including everyday shared timing) or "MUHURTHAM"
  // (Muhurtham Finder's occasion search). Every pre-V2 row backfilled to
  // "MUHURTHAM" (see migration 0020) since that was, until this PR, the
  // only path that ever created an AuraMoment.
  source                  String    // "PLAN" | "MUHURTHAM"
  activityId              String
  activityTitle           String
  activityIcon            String?

  startAt                 DateTime  @db.Timestamptz(3)
  endAt                   DateTime  @db.Timestamptz(3)
  timezone                String

  savedPersonId           String?
  savedPerson              SavedPerson? @relation(fields: [savedPersonId], references: [id], onDelete: SetNull)
  sharedPersonDisplayName String?
  senderDisplayName       String?

  ratingLabel             String?
  explanationSnapshot     String?

  status                  String    @default("ACTIVE") // "ACTIVE" | "REVOKED"
  responseState           String?   // null | "ACCEPTED" | "ANOTHER_TIME"
  // Structured recipient preference (Aura Moment Rescheduling), only ever
  // meaningful alongside responseState = "ANOTHER_TIME" -- kept as its own
  // column, never folded into responseState.
  responsePreference      String?   // null | "EARLIER" | "LATER" | "DIFFERENT_DAY" | "NO_PREFERENCE"
  respondedAt             DateTime? @db.Timestamptz(3)
  // Aura Updates V1: when the OWNER last saw this moment's response. Unread
  // is derived by comparing this to respondedAt (never a separate boolean),
  // so a new response after a prior "seen" mark is correctly unread again
  // with no extra write on the public response path itself.
  ownerSeenResponseAt     DateTime? @db.Timestamptz(3)

  // Lineage: set on a NEW moment created via "Suggest this" -- points at the
  // moment it replaces. The original is never mutated (brief section 13:
  // "Historical shares should remain immutable snapshots").
  previousMomentId        String?
  previousMoment          AuraMoment?  @relation("MomentLineage", fields: [previousMomentId], references: [id], onDelete: SetNull)
  supersededBy            AuraMoment[] @relation("MomentLineage")

  // Aura Reminders V1 dedup linkage (brief section 7, migration 0021) --
  // set only when the client already knows this Moment represents the same
  // event as an existing Plan (see PlanWithAuraView's handleMakeMoment).
  // When set, deriveAuraReminders() skips the linked Plan's own reminder in
  // favor of this Moment's richer one.
  plannedActivityId       String?
  plannedActivity         PlannedActivity? @relation(fields: [plannedActivityId], references: [id], onDelete: SetNull)

  createdAt               DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt                DateTime? @db.Timestamptz(3)
  // Product Instrumentation V1 -- set once, the first time the public page
  // successfully resolves this moment. Powers "shared -> opened" without
  // refresh inflation; see lib/productEvents.ts / the public page.
  firstOpenedAt            DateTime? @db.Timestamptz(3)

  productEvents           ProductEvent[]

  // Migration 0018 also adds a partial index on (ownerUserId, status,
  // respondedAt DESC) WHERE responseState IS NOT NULL, for the Aura
  // Updates query -- Prisma's @@index syntax has no partial-index support
  // in this schema's provider config, so it's raw-SQL-only; not
  // represented here to avoid this line implying a different index shape
  // than what's actually created.
  @@index([ownerUserId])
  @@index([ownerUserId, startAt])
}

// Product Instrumentation V1 -- a small, generic first-party event log.
// Deliberately ONE table (eventName + a tightly allow-listed metadata JSON)
// rather than one table per event type: this is a low-volume funnel log,
// not a transactional record. What `metadata` may contain per eventName is
// enforced entirely in application code (lib/productEvents.ts), never
// trusted from a raw JSON column -- see that file's doc comment for the
// full privacy/validation model. Never stores birth data, natal fields,
// SavedPerson/recipient names, email, or a moment's publicToken.
model ProductEvent {
  id           String    @id @default(uuid())
  eventName    String

  userId       String?
  user         User?       @relation(fields: [userId], references: [id], onDelete: Cascade)

  auraMomentId String?
  auraMoment   AuraMoment? @relation(fields: [auraMomentId], references: [id], onDelete: SetNull)

  metadata     Json      @default("{}")
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  // Migration 0019 also adds a composite (eventName, createdAt DESC) index
  // and two partial indexes on userId/auraMomentId -- not representable
  // here without Prisma's partial-index preview feature; raw-SQL-only, same
  // convention as AuraMoment's own partial index above.
}

model CustomCity {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cityName  String
  latitude  Float
  longitude Float
  timezone  String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([userId, cityName])
  @@index([userId])
}

model HabitLog {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  habitId        String?
  habit          Habit?   @relation(fields: [habitId], references: [id])
  activityTitle  String
  activeWindow   String   // "ABHIJIT" | "RAHU_KALAM" | "GULIKA" | "YAMA" | "BRAHMA" | "NEUTRAL"
  logTimestamp   DateTime @default(now()) @db.Timestamptz(3)
  logMinuteOfDay Int
  durationMinutes Int @default(30)
  notes          String?  @db.Text
  logSource      String   @default("MANUAL") // "AURA_PLANNED" | "AURA_DO_NOW" | "MANUAL" | "OVERRIDE_CAUTION"
  activitySignificance String @default("MEDIUM") // "LOW" | "MEDIUM" | "HIGH"

  @@index([userId, logTimestamp])
}

model PlannedActivity {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title           String
  activityType    String?
  icon            String?
  status          String   @default("UPCOMING") // "UPCOMING" | "LOGGED" | "CANCELLED"

  plannedStartAt  DateTime @db.Timestamptz(3)
  plannedEndAt    DateTime @db.Timestamptz(3)
  durationMinutes Int

  windowType      String
  windowLabel     String?
  matchLabel      String?
  score           Int?
  recommendation  String?  @db.Text
  calendarUrl     String?  @db.Text

  loggedAt        DateTime? @db.Timestamptz(3)
  habitLogId      String?

  // Event Location Plan Persistence V1 (migration 0028) -- an immutable
  // snapshot of the Event Location (packages/recommendation/src/
  // muhurthamFinder.ts's ephemeral request-local override, PR "Add
  // event-specific location to Muhurtham search") that produced this plan's
  // plannedStartAt/plannedEndAt, taken ONLY from the client's own
  // resultEventLocation (the location that actually ran the search that was
  // saved), never from the User's current Timing Location and never
  // reconstructed from live picker state. NULL on both fields means
  // "this plan used the Timing Location, not a custom Event Location" --
  // the common case, and the correct legacy value for every row that
  // predates this migration (deliberately NOT backfilled with the owner's
  // current Timing Location, which would manufacture false historical
  // information). Always set or left NULL together -- never one without
  // the other, see route.ts's own validation. No latitude/longitude: no
  // workflow recomputes Panchang/Muhurtham from a saved PlannedActivity
  // (confirmed by audit), so coordinates would be unused persisted
  // precision -- data minimization, not an oversight.
  eventTimezone     String?
  eventLocationName String?

  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  // Aura Reminders V1 dedup linkage inverse (migration 0021) -- normally 0
  // or 1 row; see AuraMoment.plannedActivityId's own doc comment.
  linkedAuraMoments AuraMoment[]

  @@index([userId, plannedStartAt])
  @@index([userId, status])
}

// Intentional Day Builder V1 (brief section 20, migration 0025) also adds a
// "PlanCreationIdempotency" table for Add idempotency, mirroring
// GuestConversionRedemption's own "claim, then fill" design (see that
// model's own doc comment above for why PlannedActivity stays unaware of
// acquisition source). Like GuestConversionRedemption, it's raw-SQL-only
// and not represented here -- same convention this schema already follows
// for that table.
//
// Migration 0026 similarly adds "DayBuilderDismissal" (the "Not today"
// dismissal table, keyed by userId + localDate + activityId + personId)
// -- also raw-SQL-only, same reasoning: it has nothing to do with
// PlannedActivity's own fields and is a small, scoped side table.

// Tracks app opens (not habit logs) — needed to measure the MVP spec's actual
// kill criteria: day-2/day-7 return rate. A user can log a habit without this ever
// firing, and can open the app without logging anything; these are deliberately
// separate signals.
model VisitLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  visitedAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId, visitedAt])
}

// A user-defined recurring habit (Phase 1.2's "recurring habits") — distinct from
// the fixed 3 action cards, which are always derived from the current window
// rather than something the user set up themselves.
model Habit {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  title            String
  category         String    // "WORKOUT" | "MEAL" | "MICRO_BREAK" | "FOCUS" | "REST"
  targetWindowType String    // "BRAHMA" | "ABHIJIT" | "RAHU_KALAM" | "GULIKA" | "YAMA" | "NEUTRAL"
  currentStreak    Int       @default(0)
  longestStreak    Int       @default(0)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  archivedAt       DateTime? @db.Timestamptz(3)

  logs             HabitLog[]
}

// One-time 6-digit sign-in codes (see migration 0011). Kept server-side for
// attempt counting and single-use semantics; the code itself is never stored,
// only an HMAC of it.
model AuthCode {
  id         String    @id @default(uuid())
  email      String
  codeHash   String
  requestIp  String?
  attempts   Int       @default(0)
  expiresAt  DateTime  @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  @@index([email, createdAt])
  @@index([requestIp, createdAt])
}

model DailyReflection {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reflectionDate  DateTime @db.Date
  outputLevel     String   // "LOW" | "MODERATE" | "PEAK_FLOW"
  followedGuidance Boolean @default(false)
  notes           String?  @db.Text
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  @@unique([userId, reflectionDate])
  @@index([userId, reflectionDate])
}

// Notification Delivery Readiness V1 -- "has the owner acknowledged THIS
// reminder occurrence in Aura", identified by (userId, scheduledItemType,
// scheduledItemId, reminderAt) rather than a bare boolean on the source
// row. A rescheduled Plan/Moment produces a NEW reminderAt, so its next
// occurrence has no matching row here and is unread again with no extra
// write anywhere -- the same "derive unread by comparison, don't store a
// boolean" pattern AuraMoment.ownerSeenResponseAt already established,
// just keyed to a specific occurrence instead of "the current state".
model ReminderAttention {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduledItemType String   // "PLANNED_ACTIVITY" | "AURA_MOMENT"
  scheduledItemId   String
  reminderAt        DateTime @db.Timestamptz(3)
  seenAt            DateTime @default(now()) @db.Timestamptz(3)

  @@unique([userId, scheduledItemType, scheduledItemId, reminderAt])
  @@index([userId, scheduledItemType, scheduledItemId])
}

// Notification Delivery Readiness V1 -- idempotent delivery-attempt
// tracking for a future Web Push worker. NOT reminder relevance (still
// computed live by deriveAuraReminders()) and NOT seen state (that's
// ReminderAttention above) -- these three stay strictly separate. The
// unique constraint below is what makes claiming safe under concurrent
// workers: INSERT ... ON CONFLICT DO NOTHING against this exact constraint
// guarantees the same reminder occurrence never produces two WEB_PUSH
// sends, without any in-memory locking. No worker exists yet in this PR --
// only ensureDueReminderDeliveries() writes here, and nothing in a live
// request path calls it yet.
model ReminderDelivery {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduledItemType String
  scheduledItemId   String
  reminderAt        DateTime  @db.Timestamptz(3)
  channel           String    // "WEB_PUSH"
  // Web Push V1 (brief section 22/24): "PENDING" | "PROCESSING" | "SENT" |
  // "FAILED" | "SKIPPED". PROCESSING is the real claim transition a worker
  // takes via an atomic UPDATE ... WHERE status = 'PENDING' before sending
  // -- the row's own uniqueness alone stops duplicate CREATION, not
  // duplicate SENDING; PROCESSING is what stops that. SKIPPED means the
  // occurrence was re-validated against deriveAuraReminders() immediately
  // before sending and was no longer eligible (rescheduled/revoked/
  // superseded) -- never sent, and never retried as this same occurrence.
  status            String    @default("PENDING")
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  sentAt            DateTime? @db.Timestamptz(3)
  failedAt          DateTime? @db.Timestamptz(3)
  failureReason     String?
  // Web Push V1 (brief section 23) -- bounded retry bookkeeping, no queue.
  attemptCount      Int       @default(0)
  lastAttemptAt     DateTime? @db.Timestamptz(3)

  @@unique([userId, scheduledItemType, scheduledItemId, reminderAt, channel])
  @@index([status])
}

// Web Push V1 -- one row per browser/device registration. `endpoint` is
// globally unique (a push endpoint URL is provider-issued and effectively
// identifies one subscription slot) -- re-registering the same endpoint
// upserts in place rather than accumulating duplicates (brief section 4).
model PushSubscription {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint         String    @unique
  p256dh           String
  auth             String
  userAgent        String?
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)
  lastSuccessfulAt DateTime? @db.Timestamptz(3)
  // Web Push V1 (brief section 18/28) -- set when the provider reports the
  // endpoint is gone (410/404) or the user explicitly turns off device
  // notifications. A disabled subscription is never sent to and never
  // deleted outright (keeps the endpoint's history/uniqueness intact,
  // matches this codebase's existing "disable, don't delete" convention
  // for state that's cheap to keep and expensive to silently lose).
  disabledAt       DateTime? @db.Timestamptz(3)

  @@index([userId])
}
