< # T1-6 process scan (FIX01: fail-closed; three outcomes CLEAN / DETECTED / UNKNOWN). Two bounded /bin/ps reads:
< #   ucomm = kernel process name (set by exec from the executed file's name, max 16 chars; NOT caller-settable via argv[0])
< #   comm  = argv[0]-derived name (caller-controlled; scanned too, so a denylisted argv[0] also STOPs)
< # Each read must exit 0, parse completely, be plausible (>= SCANMIN rows, pid 1 and own pid present, no duplicate pid).
< # Any failure, malformed row, timeout or implausible output -> UNKNOWN -> STOP. Only a fully validated scan can be CLEAN.
< DENYT=(cua_node codex chatgpt claude 'claude helper' zoom.us splashtop islonline 'isl online' superops teamviewer anydesk rustdesk screenconnect screensharingd ardagent hammerspoon 'keyboard maestro' keyboardmaestro bettertouchtool osascript)
< ps_read() {   # $1 = ucomm or comm -> PSOUT, PSRC (124 timeout, 125 temp-file failure); bounded by SCANTO seconds
<   local f p e; PSOUT=''; PSRC=125
<   f=$(/usr/bin/mktemp "$TD/r2d-scan.XXXXXXXX") || return; SCANF+=" $f"
<   "$PSB" -ww -axo "pid=,ppid=,$1=" > "$f" 2>/dev/null & p=$!; e=$(( $(now) + SCANTO ))
<   while kill -0 $p 2>/dev/null; do
<     (( $(now) < e )) || { kill -KILL $p 2>/dev/null; wait $p 2>/dev/null; PSRC=124; /bin/rm -f -- "$f"; return; }
<     sleep 0.05; done
<   wait $p; PSRC=$?; PSOUT=$(<"$f"); /bin/rm -f -- "$f"; }
< ps_parse() {  # $1 column; fills caller's PT (pid->ppid) and NT (pid->name); 0 = valid, else sets SCANWHY
<   local l n=0 nm
<   (( PSRC == 0 )) || { SCANWHY="$1 read: ps exit status $PSRC"; return 1; }
<   [[ -n $PSOUT ]] || { SCANWHY="$1 read: empty output"; return 1; }
<   for l in "${(@f)PSOUT}"; do (( n++ ))
<     [[ $l =~ '^ *([0-9]+) +([0-9]+) +([^ ].*)$' ]] || { SCANWHY="$1 read: malformed row $n"; return 1; }
<     [[ -z ${PT[$match[1]]-} ]] || { SCANWHY="$1 read: duplicate pid in row $n"; return 1; }
<     PT[$match[1]]=$match[2]; nm=$match[3]; while [[ $nm == *[[:space:]] ]]; do nm=${nm%?}; done; NT[$match[1]]=$nm; done   # real ucomm is space-padded to 16
<   (( n >= SCANMIN )) || { SCANWHY="$1 read: implausible row count $n (< $SCANMIN)"; return 1; }
<   [[ -n ${PT[1]-} ]] || { SCANWHY="$1 read: pid 1 (launchd) row missing"; return 1; }
<   [[ -n ${PT[$ME]-} ]] || { SCANWHY="$1 read: own pid $ME row missing"; return 1; }
<   NROWS=$n; return 0; }
< deny_hit() { local x=${(L)1} t; for t in $DENYT; do [[ $x == "$t"* ]] && return 0; done; return 1; }
< t16_scan() {  # -> SCAN, SCANWHY, HIT
<   local -A PT NT PU NU PC NC; local p h=() pu pc
<   SCAN=UNKNOWN; SCANWHY=''; HIT=''
<   ps_read ucomm; ps_parse ucomm || return; PU=("${(@kv)PT}"); NU=("${(@kv)NT}"); PT=(); NT=()
<   ps_read comm;  ps_parse comm  || return; PC=("${(@kv)PT}"); NC=("${(@kv)NT}")
<   for p in ${(k)PU} ${(k)PC}; do
<     pu=${PU[$p]-}; pc=${PC[$p]-}
<     [[ $p == $ME ]] && continue
<     [[ $pu == $ME && ( -z $pc || $pc == $ME ) ]] && continue     # direct child of the harness (both reads agree)
<     [[ $pc == $ME && -z $pu ]] && continue
<     deny_hit "${NU[$p]-}" && h+=("ucomm:${NU[$p]}")
<     deny_hit "${${NC[$p]-}:t}" && h+=("comm:${${NC[$p]}:t}")
<   done
<   h=(${(ou)h}); HIT=${(j:;:)h}
<   if (( ${#h} )); then SCAN=DETECTED; else SCAN=CLEAN; fi; }
< t16_scan
< case $SCAN in
<   CLEAN) log "T1-6: process scan CLEAN (ucomm+comm validated, rows=$NROWS)";;
<   DETECTED) stop "T1-6: UI-automation / remote-control process running: $HIT";;
<   *) VERDICT='STOPPED (T1-6 process scan UNKNOWN)'; stop "T1-6: process scan UNKNOWN ($SCANWHY) - not treated as clean";;
< esac
