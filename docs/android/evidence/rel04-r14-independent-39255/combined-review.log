+import { fixtureAnchorMonday, addCivilDays, realClockReferenceForFixture } from './lifecycleFixtureCalendar';
-// 2026-12-01T06:30:00Z = 2026-12-01 12:00 IST (safely mid-day, no midnight-adjacent ambiguity).
